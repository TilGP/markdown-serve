#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v uv >/dev/null 2>&1; then
  echo "markdown-serve: uv is required but was not found in PATH" >&2
  exit 1
fi

export PYTHONUNBUFFERED=1
# Use --project (not --directory) so the caller's CWD is preserved as the serve root.
exec uv run --project "$ROOT" -- markdown-serve "$@"
